# Copy this file to .env to have it loaded automatically (server.js now
# calls `import 'dotenv/config'` on startup). Without a .env file, these
# fall back to the defaults below — including the insecure default admin
# password, which the server will warn about loudly on startup.

PORT=3001
ADMIN_PASSWORD=change_me

# Purely informational — printed in the startup log so it's obvious at a
# glance which mode a running process thinks it's in. Nothing in the code
# branches on this value; it does not enable/disable anything by itself.
# Set it to "production" on a real deploy so the startup log (and anyone
# reading it) reflects reality.
NODE_ENV=development

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Leave unset/empty for local dev — it then falls back to the
# hardcoded localhost dev ports below. For a real deploy, set this to your
# actual frontend domain(s), e.g.:
#   CORS_ORIGINS=https://overeno.cz,https://www.overeno.cz
# The server warns loudly at startup if this is still unset once
# PAYMENTS_ENABLED or EMAIL_ENABLED look production-like (see below).
CORS_ORIGINS=

# --- Email notifications -----------------------------------------------
# Master switch. With EMAIL_ENABLED=false (the default) nothing is ever
# sent — leads/bookings/VIN checks still save normally either way.
EMAIL_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=no-reply@overeno.example
FROM_NAME=OVĚŘENO

# Who gets the "new lead/booking/vin-check" notification. ADMIN_NOTIFICATION_EMAIL
# wins if both are set; leave both empty to skip the admin email entirely
# (the record still saves).
ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Used to build the admin-*.html links inside notification emails.
APP_URL=http://localhost:8000

# Whether attempts (including skipped ones) get written to the email_logs
# table. See backend/README.md for exactly what gets logged.
EMAIL_LOGGING_ENABLED=true

# --- Payments (sandbox/test only — see backend/README.md) --------------
# Master switch, same idea as EMAIL_ENABLED. With PAYMENTS_ENABLED=false
# (the default) POST /payments/checkout returns a clear "disabled" error
# instead of creating anything — nothing else on the site is affected.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock

# PAYMENT_PROVIDER=mock (default): no real provider involved at all,
# checkoutUrl points straight at payment-success.html with a mock=1
# marker. Good for local dev/demos, no Stripe account needed.
#
# PAYMENT_PROVIDER=stripe: everything below this line becomes required.
# ALWAYS use Stripe TEST MODE keys (sk_test_... / whsec_...), never live
# (sk_live_...) keys — and never commit real values of either to this
# file, or to any file that leaves your machine. See backend/README.md's
# "Stripe test mode setup" section for the full walkthrough (where to
# find these in the Stripe Dashboard / Stripe CLI, how to point a webhook
# at this backend, and what to test before trusting it).
#
# STRIPE_SECRET_KEY: Stripe Dashboard → Developers → API keys → "Secret
# key" while in Test mode (top-right toggle). Starts with sk_test_.
#
# STRIPE_WEBHOOK_SECRET: only known once a webhook endpoint exists.
# Easiest for local dev: `stripe listen --forward-to localhost:3001/payments/webhook`
# (Stripe CLI) prints a whsec_... value to use here. For a real deployed
# backend: Stripe Dashboard → Developers → Webhooks → Add endpoint,
# pointing at https://<your-backend-domain>/payments/webhook, then copy
# the "Signing secret" it generates (also whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Must be real, reachable frontend pages — Stripe redirects the customer's
# browser here after checkout. Not secrets, just regular URLs.
STRIPE_SUCCESS_URL=http://localhost:8000/payment-success.html
STRIPE_CANCEL_URL=http://localhost:8000/payment-cancel.html

# APP_URL is shared with the email templates above — also used by the mock
# provider to build its fake checkoutUrl, and to build the public report
# link (report.html?token=...) in "Send to customer" emails and the
# admin's "Copy link" button.

# --- AI orchestrator foundation (mock only — see backend/README.md) -----
# Master switch, same idea as EMAIL_ENABLED/PAYMENTS_ENABLED. With
# AI_ENABLED=false (the default) POST /admin/ai/run returns a clear
# "disabled" error instead of running anything — nothing else on the
# site is affected, and no AI provider is ever contacted.
AI_ENABLED=false

# Only "mock" is actually implemented in this step — deterministic,
# offline, no network call, no cost. "openai"/"anthropic" are accepted
# values (won't be rejected at startup) so the provider interface is
# ready for a real SDK later, but selecting one now without AI_API_KEY
# just means POST /admin/ai/run returns a clear "not configured" error —
# the backend never crashes over this.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# --- GPT/OpenAI readiness (see backend/README.md's "GPT API readiness"
# section) — config only, no real OpenAI call is implemented anywhere in
# this codebase yet. OPENAI_API_KEY is provided ONLY by the project
# owner — never generate or guess a value, never commit a real one to
# this file or any file that leaves the machine, and never put it
# anywhere in the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Independent money-safety gate — even with a valid OPENAI_API_KEY set,
# AI_PROVIDER=openai stays "not configured" (POST /admin/ai/run returns
# a clear error, never a real call) until this is deliberately set above
# zero. Both this AND the API key must be set before a real provider
# call would even be attempted once one is actually implemented.
AI_MONTHLY_BUDGET_LIMIT=0

# Hard cap on how much input (JSON-stringified) one agent run will
# accept, characters. Requests over this are rejected before anything
# resembling an AI call happens — protects against runaway cost/latency
# even with a real provider later.
AI_MAX_INPUT_CHARS=20000

# Every AI run is marked as requiring human review by default — this
# flag exists for completeness but flipping it to false does NOT skip
# the review workflow in this step; see backend/README.md's "AI
# orchestrator foundation" section for exactly why.
AI_REQUIRE_HUMAN_REVIEW=true

# --- Real VIN provider adapter (see backend/README.md) -------------------
# Master switch. "demo" (default) is the ONLY mode the public
# POST /vin/check form ever uses, regardless of this setting — a real,
# possibly-billed provider is only ever called from the admin-only
# POST /admin/vin-checks/:id/run-provider endpoint. "mock_real" is a
# third, no-cost option for testing the real-provider parsing/
# normalization pipeline without any network access or API key — see
# backend/vin/realVinProviderAdapter.js.
VIN_PROVIDER=demo

# Only used when VIN_PROVIDER=real. No specific VIN/vehicle-history
# provider is picked or wired up in this step (see backend/README.md's
# honest note on this) — before setting these, read that section for
# the ToS/legal considerations of whichever provider you choose, and
# never commit real values of either to this file or any file that
# leaves your machine.
VIN_API_BASE_URL=
VIN_API_KEY=

# How long to wait for a real provider before giving up (milliseconds).
VIN_PROVIDER_TIMEOUT_MS=10000

# Money-safety default — TRUE means a real (possibly-billed) provider
# call is only allowed against a vin_check whose paymentStatus is
# "paid". Only an admin deliberately setting this to "false" can call a
# real provider against an unpaid check; the out-of-the-box behavior
# never risks spending money on a check nobody paid for.
VIN_REQUIRE_PAYMENT_FOR_REAL_CHECK=true

